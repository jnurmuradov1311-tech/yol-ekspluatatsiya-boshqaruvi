# Local Docker Compose only. Generate unique values; never reuse these in production.
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
WEB_URL=http://localhost:8080
POSTGRES_DB=roadops
POSTGRES_USER=roadops_owner
POSTGRES_PASSWORD=
DB_USERNAME=roadops_php
DB_PASSWORD=
DB_SYNC_USERNAME=roadops_sync_login
DB_SYNC_PASSWORD=
# Optional read-only reporting connection; supply both or neither.
DB_REPORT_USERNAME=
DB_REPORT_PASSWORD=

ROADOPS_PORT=8080
SESSION_SECURE_COOKIE=false
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXIES=172.16.0.0/12
MANUAL_EVIDENCE_S3_BUCKET=
MANUAL_EVIDENCE_S3_REGION=
MANUAL_EVIDENCE_S3_PREFIX=manual-inspections/
MANUAL_EVIDENCE_MAX_BYTES=262144000
EXECUTION_EVIDENCE_ALLOWED_ORIGINS=https://evidence.example.uz

# Both integrations remain disabled until approved vendor contracts and credentials exist.
YTP_SYNC_ENABLED=false
YTP_BASE_URL=
YTP_CLIENT_ID=
YTP_CLIENT_SECRET=
YTP_WEBHOOK_SECRET=

ROADVISION_MODE=s3_manifest
ROADVISION_SYNC_ENABLED=false
ROADVISION_API_URL=
ROADVISION_CLIENT_ID=
ROADVISION_CLIENT_SECRET=
ROADVISION_WEBHOOK_SECRET=
ROADVISION_S3_BUCKET=
ROADVISION_S3_REGION=
ROADVISION_S3_PREFIX=results/
ROADVISION_EVIDENCE_MAX_BYTES=262144000
ROADVISION_MANIFEST_CANONICALIZATION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
