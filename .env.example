APP_NAME="Yo'l ekspluatatsiyasini boshqarish"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://roadops.example.uz
APP_KEY=
WEB_URL=https://roadops.example.uz
PRIMARY_ROAD_CODE=D001
PRIMARY_ROAD_LENGTH_M=67000

DB_CONNECTION=pgsql
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_SYNC_USERNAME=roadops_sync_login
DB_SYNC_PASSWORD=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
DB_REPORT_USERNAME=
DB_REPORT_PASSWORD=

SESSION_COOKIE=roadops_session
SESSION_SECURE_COOKIE=true
SESSION_TTL_MINUTES=480
CORS_ALLOWED_ORIGINS=https://roadops.example.uz
MANUAL_EVIDENCE_S3_BUCKET=
TRUSTED_PROXIES=10.0.0.0/8

REDIS_URL=redis://redis:6379

YTP_SYNC_ENABLED=false
YTP_BASE_URL=
YTP_CLIENT_ID=
YTP_CLIENT_SECRET=
YTP_WEBHOOK_SECRET=

ROADVISION_MODE=s3_manifest
ROADVISION_SYNC_ENABLED=false
ROADVISION_API_URL=
ROADVISION_CLIENT_ID=
ROADVISION_CLIENT_SECRET=
ROADVISION_WEBHOOK_SECRET=
ROADVISION_S3_BUCKET=
ROADVISION_S3_REGION=
ROADVISION_S3_PREFIX=results/
ROADVISION_EVIDENCE_MAX_BYTES=262144000
ROADVISION_MANIFEST_CANONICALIZATION=

SLACK_WEBHOOK_URL=
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=roadops@example.uz
