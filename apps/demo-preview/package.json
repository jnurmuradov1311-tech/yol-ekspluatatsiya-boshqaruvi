{
  "name": "roadops-demo-preview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "NEXT_PUBLIC_E2E_FIXTURES=true NEXT_PUBLIC_API_BASE_URL=/api/v1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test:logic": "node --test tests/connected-demo.test.mjs tests/annual-funding.test.mjs tests/funding.test.mjs tests/ai-selection.test.mjs",
    "test:interaction": "node tests/run-planner-interaction.mjs && node tests/run-funding-interaction.mjs && node tests/run-funding-interaction.mjs tests/annual-interaction.tsx && node tests/run-funding-interaction.mjs tests/script-interaction.tsx"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.10.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@cloudflare/workers-types": "5.20260917.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "jsdom": "27.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.134.0"
  },
  "type": "module",
  "displayName": "RoadOps boshqaruv tizimi — Demo",
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    }
  }
}
