# Same-origin browser path. Keep this value for cookie and CSRF protection.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional server-side proxy target when PHP is a separate service.
BACKEND_INTERNAL_URL=http://api:8080

# Tests only. Never set this in a production environment.
NEXT_PUBLIC_E2E_FIXTURES=false

# Organisation-approved MapLibre style JSON endpoint.
NEXT_PUBLIC_MAP_STYLE_URL=

# Comma-separated HTTPS origins used by that style for tiles, sprites and glyphs.
# The public OSM tile origin is already included for the built-in fallback.
NEXT_PUBLIC_MAP_CSP_ORIGINS=
