APP_NAME="Yo'l ekspluatatsiyasini boshqarish"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
WEB_URL=http://localhost:3000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=roadops
DB_USERNAME=roadops_php
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SYNC_USERNAME=roadops_sync_login
DB_SYNC_PASSWORD=
DB_MIGRATION_USERNAME=roadops_owner
DB_MIGRATION_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_COOKIE=roadops_session
SESSION_SECURE_COOKIE=false
SESSION_TTL_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:3000
MANUAL_EVIDENCE_S3_BUCKET=
MANUAL_EVIDENCE_S3_REGION=
MANUAL_EVIDENCE_S3_PREFIX=manual-inspections/
MANUAL_EVIDENCE_MAX_BYTES=262144000
EXECUTION_EVIDENCE_ALLOWED_ORIGINS=https://evidence.example.uz
TRUSTED_PROXIES=127.0.0.1,::1

# Integrations stay disabled/not-ready until the official contracts and the
# manifest canonicalization are approved by each source owner.
YTP_SYNC_ENABLED=false
YTP_BASE_URL=
YTP_CLIENT_ID=
YTP_CLIENT_SECRET=
YTP_WEBHOOK_SECRET=
ROADVISION_MODE=s3_manifest
ROADVISION_SYNC_ENABLED=false
ROADVISION_API_URL=
ROADVISION_CLIENT_ID=
ROADVISION_CLIENT_SECRET=
ROADVISION_WEBHOOK_SECRET=
ROADVISION_S3_BUCKET=
ROADVISION_S3_REGION=
ROADVISION_S3_PREFIX=results/
ROADVISION_EVIDENCE_MAX_BYTES=262144000
ROADVISION_MANIFEST_CANONICALIZATION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
