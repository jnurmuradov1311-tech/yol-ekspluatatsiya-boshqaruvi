{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "roadops/api",
  "type": "project",
  "description": "Yo'l ekspluatatsiyasi operativ boshqaruv API",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "aws/aws-sdk-php": "^3.352",
    "brick/math": "^0.14",
    "laravel/framework": "^13.0",
    "league/flysystem-aws-s3-v3": "^3.30",
    "phpoffice/phpspreadsheet": "^5.1"
  },
  "require-dev": {
    "larastan/larastan": "^3.8",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "format:check": "pint --test",
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
